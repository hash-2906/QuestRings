# QuestRings Keystore Configuration Template
# Copy this file to 'keystore.properties' and fill in your secure credentials.
# NEVER commit 'keystore.properties' or your .jks file to version control.

storeFile=/absolute/path/to/questrings_release.jks
storePassword=YourSecureStorePassword
keyAlias=questrings_key
keyPassword=YourSecureKeyPassword
